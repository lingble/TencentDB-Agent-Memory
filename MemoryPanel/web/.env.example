# ============================================================
#  Web frontend environment variables
# ============================================================
#  Copy this file to .env and edit the values:
#    cp .env.example .env
#
#  Restart the dev server to apply (Vite does not hot-reload env vars).

# ─── Control backend URL (vite proxy) ──────────────────────
# Default: http://127.0.0.1:8123 (see web/vite.config.ts)
# VITE_TMC_BACKEND_URL=http://127.0.0.1:8123

# ─── Memory Gateway (optional, /v3 proxy) ──────────────────
# VITE_SKILL_GATEWAY_URL=http://127.0.0.1:8420
