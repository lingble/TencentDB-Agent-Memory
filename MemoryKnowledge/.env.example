# Knowledge Service configuration
# Usage: cp .env.example .env && edit .env
# .env is loaded automatically by `import 'dotenv/config'` at the top of src/config.ts

# ═══ HTTP Server ═══
PORT=8421
API_PREFIX=/v3
LOG_LEVEL=debug

# ═══ Service-to-service auth ═══
# Empty (default) = auth disabled; all /v3 endpoints are open (local development only).
# Non-empty = every endpoint except the read-only allowlist (tools/*, wiki/code-graph queries, llm-binding status/list, etc.)
# requires `Authorization: Bearer <KNOWLEDGE_SERVICE_KEY>`.
# Must be set for production/shared deployments; the deploy/global-images startup script generates it automatically and distributes it to Panel.
# KNOWLEDGE_SERVICE_KEY=

# ═══ Data storage ═══
# Data root directory: git clones, wiki sources, BM25 indexes, and SQLite all live under this directory
KNOWLEDGE_DATA_DIR=./data
# SQLite database path (4 tables: knowledge_wiki / knowledge_code_graph / *_audit)
KNOWLEDGE_DB_PATH=./data/knowledge.db

# ═══ LLM configuration (required for wiki ingest; code-graph does not depend on it) ═══
# LLM_MODE: global default routing (a per-instance llm_binding always takes precedence over this)
#   proxy (default): routes through the cloud Proxy, billed with the knowledge-service key pushed by TMC.
#                  KS does not need to run a Proxy locally; errors if there is no binding (no silent direct connection).
#   custom         : connects directly to your own endpoint (BYO) using LLM_BASE_URL/LLM_API_KEY below.
LLM_MODE=proxy
LLM_PROVIDER=custom
LLM_MODEL=Memory-Model
LLM_MAX_TOKENS=32768
LLM_TIMEOUT_MS=1200000

# Only needed when LLM_MODE=custom; inject LLM API credentials in the runtime environment.
LLM_BASE_URL=

# ═══ MCP Server (used only by src/mcp/server.ts) ═══
# The MCP server calls this service's API over HTTP; configure the forwarding target here
KNOWLEDGE_API_URL=http://localhost:8421
# KNOWLEDGE_API_TOKEN=optional-bearer-token

# ═══ Integration with control plane (team-memory-control) ═══
# For TMC + KS deployments, the following two settings must be configured explicitly. Their defaults in code are empty:
# - PUBLIC_BASE_URL must be an address reachable by the Agent and must include /v3;
# - CALLBACK_URL must be the TMC root address only; the program appends /api/v1/knowledge/status-callback automatically.
# For Docker deployments use the CLI: --public-url / --tmc-callback (see docs/deployment.md)
KNOWLEDGE_PUBLIC_BASE_URL=http://localhost:8421/v3
TMC_CALLBACK_URL=http://localhost:8123

# Control-plane-side configuration (not read by this service):
#   KNOWLEDGE_SERVICE_URL=http://127.0.0.1:8421

# ═══ Wiki ingest concurrency (optional) ═══
# Number of concurrent stage-1 LLM extractions within a single wiki, default 3, clamped to 1~10
# KNOWLEDGE_WIKI_INGEST_CONCURRENCY=3
# Global max LLM concurrency (extract + merge across all wikis), default 5, clamped to 1~20
# KNOWLEDGE_LLM_GLOBAL_CONCURRENCY=5

# ═══ ClickHouse tool-call telemetry (optional, disabled by default) ═══
# Only collects POST /v3/tools/call; writes to tool_call_logs, which shares its schema with Memory/Skill.
# Request bodies are recursively redacted and truncated to 512 bytes; write failures do not affect Knowledge requests.
KNOWLEDGE_CLICKHOUSE_ENABLED=false
KNOWLEDGE_CLICKHOUSE_URL=http://127.0.0.1:8123
KNOWLEDGE_CLICKHOUSE_DATABASE=default
KNOWLEDGE_CLICKHOUSE_TABLE=tool_call_logs
KNOWLEDGE_CLICKHOUSE_USER=default
# When auth is enabled, inject the ClickHouse password in the runtime environment.
KNOWLEDGE_CLICKHOUSE_FLUSH_INTERVAL_MS=5000
KNOWLEDGE_CLICKHOUSE_FLUSH_THRESHOLD=50
KNOWLEDGE_CLICKHOUSE_TTL_DAYS=90
KNOWLEDGE_CLICKHOUSE_REQUEST_TIMEOUT_MS=5000

# ═══ Code-Graph scheduled auto-sync ═══
# Periodically scans all code-graphs in ready status; a FIFO queue + worker pool pulls the latest git
# and rebuilds the index. Disabled by default; when enabled, per-repo sync frequency = max(single sync duration, SCAN interval).
# Observe: GET /v3/auto-sync/status | Manual trigger: POST /v3/auto-sync/trigger
KNOWLEDGE_AUTO_SYNC_ENABLED=false
# Scan interval (minutes), clamped to 1~60
KNOWLEDGE_AUTO_SYNC_SCAN_INTERVAL_MIN=10
# Number of concurrent workers (max repos syncing at once), clamped to 1~20
KNOWLEDGE_AUTO_SYNC_MAX_CONCURRENT=3
